# =============================================================================
# Genesis Configuration
# =============================================================================
# This file defines all configuration options for Genesis.
# Values without defaults are REQUIRED and must be uncommented.
# Values with defaults are OPTIONAL and can be left commented out to use defaults.
#
# Environment variable format: genesis__<section>__<key>
# Nested sections use double underscore: genesis__models__default__provider
#
# See docs/ for full configuration reference.
# =============================================================================

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================
# These values have no defaults and MUST be set for Genesis to function.

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Define at least one LLM provider. The key (e.g., "openrouter") is your nickname.
genesis__providers__openrouter__name="openrouter"
genesis__providers__openrouter__base_url="https://openrouter.ai/api/v1"
genesis__providers__openrouter__api_key=""

# Additional providers can be added with different keys:
# genesis__providers__openai__name="openai"
# genesis__providers__openai__base_url="https://api.openai.com/v1"
# genesis__providers__openai__api_key=""

# genesis__providers__anthropic__name="anthropic"
# genesis__providers__anthropic__base_url="https://api.anthropic.com"
# genesis__providers__anthropic__api_key=""

# genesis__providers__llamacpp__name="openai"
# genesis__providers__llamacpp__base_url="https://localhost:1234/v1"
# genesis__providers__llamacpp__api_key=""

# -----------------------------------------------------------------------------
# LLM Model Configuration
# -----------------------------------------------------------------------------
# Define models that reference your providers.
genesis__models__default__provider="openrouter"
genesis__models__default__model="nvidia/nemotron-3-nano-30b-a3b:free"

# Additional model configurations:
# genesis__models__gemini__provider="llamacpp"
# genesis__models__gemini__model="google/gemma-4-e4b"
# genesis__models__default__params__temperature=0.5

# -----------------------------------------------------------------------------
# Server Admin Configuration (Required for server mode)
# -----------------------------------------------------------------------------
# genesis__server__admin_username=""
# genesis__server__admin_password=""
# genesis__server__admin_email=""

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================
# These values have defaults and can be left commented out to use defaults.

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
# Timezone for the working context (CLI or per-user on server)
# genesis__timezone="Australia/Adelaide"

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# genesis__log_level="WARNING"

# Default model nickname to use when not specified
# genesis__default_model="default"

# -----------------------------------------------------------------------------
# Path Configuration
# -----------------------------------------------------------------------------
# Working directory context (server or individual user's workspace)
# genesis__path__working_directory="/path/to/working/dir"

# Server root directory (where the CLI is called)
# genesis__path__server_root_directory="/path/to/server/root"

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Server host binding
# genesis__server__host="0.0.0.0"

# Server port
# genesis__server__port=8000

# CORS allowed origins (comma-separated list)
# genesis__server__cors_origins='["http://localhost:3000"]'

# Extra CORS origins (comma-separated additional origins)
# genesis__server__cors_origins_extra="https://yoga.tail43a73c.ts.net,https://other.tail.net"

# JWT secret key for token signing (auto-generated if not set)
# genesis__server__jwt_secret_key=""

# JWT algorithm
# genesis__server__algorithm="HS256"

# Access token expiration time in minutes
# genesis__server__access_token_expire_minutes=600

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# System-wide database DSN (leave empty to use default SQLite)
# genesis__db__dsn=""

# System-wide database name
# genesis__db__db_name="genesis.db"

# Echo SQL statements (for debugging)
# genesis__db__echo_sql=false

# User-specific database DSN
# genesis__user_db__dsn=""

# User-specific database name
# genesis__user_db__db_name="user_private.db"

# Memory database DSN
# genesis__memory_db__dsn=""

# Memory database name
# genesis__memory_db__db_name="user_memory.db"

# -----------------------------------------------------------------------------
# Agent Loop Configuration
# -----------------------------------------------------------------------------
# Clipboard item TTL (time-to-live in loop iterations)
# genesis__agent_loop_config__clipboard_item_ttl=100
